<menu>
    {{#each buttons}}
    <li class="calendar-button">
        {{> ".button" }}
        {{#if additional}}
        <menu class="dropdown flexcol unlist">
            {{#each additional}}
            <li class="calendar-button">
                {{> ".button" }}
            </li>
            {{/each}}
        </menu>
        {{/if}}
    </li>
    {{/each}}
</menu>

{{#*inline ".button"}}
<button type="button" {{~#if action}} data-action="{{ action }}"{{/if}} {{ dnd5e-dataset dataset }}
        data-index="{{ index }}" {{~#if tooltip}} data-tooltip aria-label="{{ tooltip }}"
        data-tooltip-direction="{{ tooltipDirection }}"{{/if}}>
    {{#if icon}}<svg class="cult-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{#if (eq action "advance")}}<path d="m4 5 7 7-7 7m9-14 7 7-7 7"/>{{else if (eq action "reverse")}}<path d="m20 5-7 7 7 7m-9-14-7 7 7 7"/>{{else if (eq action "openCharacterSheet")}}<circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/>{{else if (eq action "openPartySheet")}}<circle cx="9" cy="7" r="3"/><path d="M3 22v-3a6 6 0 0 1 12 0v3m2-17a3 3 0 0 1 0 6m1 4a6 6 0 0 1 4 6"/>{{else}}<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18"/>{{/if}}</svg>{{/if}}
    {{#if label}}{{ label }}{{/if}}
</button>
{{/inline}}
