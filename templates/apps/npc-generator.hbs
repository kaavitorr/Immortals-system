<section class="iw-ng-main">
{{#if catalogReady}}
 <header class="iw-ng-banner"><img src="{{headerImage}}" alt="" width="64" height="64"><div><h2>Criar PdN</h2><p>Defina a criatura e seu caminho de cultivo.</p></div><span class="iw-ng-edition">Immortals<strong>Legacy</strong></span></header>
 <div class="iw-ng-scroll" data-scroll="workspace">
 <div class="iw-ng-workspace">
  <aside class="iw-ng-profile" aria-label="Perfil da criatura">
   <section class="iw-ng-identity">
    <label class="iw-ng-field iw-ng-name"><span>Nome <small>opcional</small></span><input type="text" data-field="name" data-focus-key="name" value="{{draft.name}}" placeholder="Definido pelos perfis" autocomplete="off"></label>
    <div class="iw-ng-cultivation"><label class="iw-ng-field"><span>Reino de cultivo</span><select data-field="rank" data-focus-key="rank">{{#each realms}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label class="iw-ng-field"><span>Estágio</span><select data-field="stage" data-focus-key="stage">{{#each stages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><span class="iw-ng-level" title="Nível total de cultivo"><strong>{{preview.level}}</strong><small>/ 30</small></span></div>
    <fieldset class="iw-ng-nature"><legend>Natureza</legend>{{#each natures}}<label><input type="radio" name="npc-nature" data-field="nature" data-focus-key="nature-{{value}}" value="{{value}}" {{checked selected}}><span>{{label}}</span></label>{{/each}}</fieldset>
    <label class="iw-ng-profile-field"><span>Taxonomia</span><div><img src="{{#if selectedTaxonomy.img}}{{selectedTaxonomy.img}}{{else}}systems/Immortals-system/icons/svg/items/taxonomy.svg{{/if}}" data-fallback="systems/Immortals-system/icons/svg/items/taxonomy.svg" alt="" width="72" height="72"><select data-field="taxonomyUuid" data-focus-key="taxonomy" aria-label="Taxonomia"><option value="">Escolha uma taxonomia</option>{{#each taxonomyGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</optgroup>{{/each}}</select></div></label>
    <label class="iw-ng-profile-field"><span>Arquétipo</span><div><img src="{{#if selectedArchetype.img}}{{selectedArchetype.img}}{{else}}systems/Immortals-system/icons/svg/items/archetype.svg{{/if}}" data-fallback="systems/Immortals-system/icons/svg/items/archetype.svg" alt="" width="72" height="72"><select data-field="archetypeUuid" data-focus-key="archetype" aria-label="Arquétipo" {{disabled (not selectedTaxonomy)}}><option value="">Escolha um arquétipo</option>{{#each archetypeGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</optgroup>{{/each}}</select></div></label><p class="iw-ng-note">{{archetypeHint}}</p>
   </section>
   <fieldset class="iw-ng-existence"><legend>Classificação de existência</legend><div>{{#each classifications}}<label class="iw-ng-existence-choice"><input type="radio" name="npc-category" data-field="category" data-focus-key="category-{{value}}" value="{{value}}" {{checked selected}}><span class="iw-ng-existence-button"><img src="{{img}}" alt="" width="50" height="50"><span><strong>{{label}}</strong><small>×{{multiplier}} Vida</small><small>{{actions}} ações</small></span></span></label>{{/each}}</div></fieldset>
   <section class="iw-ng-summary" aria-label="Prévia da ficha">
    <header><h3>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}Prévia da ficha</h3>{{#if preview.stats}}<div class="iw-ng-cr-preview"><span>CR base</span><span class="iw-ng-cr-value"><svg viewBox="0 0 36 40" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M8 1h20l7 7v24l-7 7H8l-7-7V8Z"/><path d="M9 4h18l5 5v22l-5 5H9l-5-5V9Z" opacity=".4"/></svg><strong>{{preview.stats.cr}}</strong></span></div>{{/if}}</header>
    {{#if preview.stats}}
    <dl class="iw-ng-vitals"><div data-resource="life"><dt>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="heart"}}Vida</dt><dd>{{preview.stats.hp}}</dd></div><div data-resource="qi"><dt>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}Qi</dt><dd>{{preview.stats.qi}}</dd></div></dl>
    <dl class="iw-ng-economy"><div><dt>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="action"}}Ações</dt><dd>{{preview.stats.actions}}</dd></div><div><dt><img src="systems/Immortals-system/assets/wuxia/refinement-lotus-v4.webp" alt="" width="15" height="17">Refinamento</dt><dd>{{preview.stats.refinement}}<small>PQ</small></dd></div></dl>
    <dl class="iw-ng-abilities">{{#each abilities}}<div data-ability="{{key}}"><dt>{{label}}</dt><dd><strong>{{value}}</strong></dd></div>{{/each}}</dl>
    <p class="iw-ng-preview-note">Armaduras e efeitos são aplicados no cálculo final da ficha.</p>
    {{else}}<p class="iw-ng-note">Escolha os perfis para visualizar os atributos e recursos.</p>{{/if}}
   </section>
   <details class="iw-ng-loot" data-detail-key="loot" {{#if lootOpen}}open{{/if}}><summary>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}Recompensas na morte</summary><label><input type="checkbox" data-loot="essence" data-focus-key="loot-essence" {{checked draft.loot.essence}}><span><strong>Essência de Besta</strong><small>Características e transformação.</small></span></label><label><input type="checkbox" data-loot="core" data-focus-key="loot-core" {{checked draft.loot.core}}><span><strong>Núcleo de Besta</strong><small>Cristal elemental.</small></span></label>{{#if draft.loot.core}}<label class="iw-ng-field"><span>Elemento do núcleo</span><select data-loot="elementId" data-focus-key="core-element">{{#each elements}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}<p class="iw-ng-note">Materiais marcados são garantidos. O mestre confirma a criação na morte.</p></details>
  </aside>
  <div class="iw-ng-editor">
   <nav class="iw-ng-panels" role="tablist" aria-label="Preparação da criatura"><button type="button" role="tab" id="iw-ng-equipment-tab" data-action="switchPanel" data-panel="equipment" aria-controls="iw-ng-equipment-panel" aria-selected="{{#if equipmentPanel}}true{{else}}false{{/if}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="inventory"}}Equipamentos <small>{{preview.equipment.length}}</small></button><button type="button" role="tab" id="iw-ng-features-tab" data-action="switchPanel" data-panel="features" aria-controls="iw-ng-features-panel" aria-selected="{{#if featuresPanel}}true{{else}}false{{/if}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="tree"}}Habilidades <small>{{selectedFeatures}}</small></button></nav>
   <section id="iw-ng-equipment-panel" class="iw-ng-gear" role="tabpanel" aria-labelledby="iw-ng-equipment-tab" data-generator-panel="equipment" data-equipment-drop {{#unless equipmentPanel}}hidden{{/unless}}>
    <header class="iw-ng-section-heading"><h3>Armas, membros e armaduras</h3><p>Os equipamentos dos perfis entram automaticamente. Marque os adicionais.</p></header>
    <div data-equipment-browser class="iw-ng-browser"><div class="iw-ng-equipment-filters"><label class="iw-ng-search"><svg class="jj2-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input type="search" data-equipment-search data-focus-key="equipment-search" aria-label="Buscar equipamentos" placeholder="Buscar nesta pasta…" value="{{gearFilters.query}}"></label><select data-equipment-source data-focus-key="equipment-source" aria-label="Origem dos equipamentos"><option value="">Todas as origens</option>{{#each equipmentSources}}<option value="{{this}}">{{this}}</option>{{/each}}</select></div>
     <div class="iw-ng-equipment-browser"><nav class="iw-ng-folders" aria-label="Pastas de equipamentos" data-scroll="folders">
      <button type="button" data-equipment-folder="base" aria-pressed="{{#if baseFolder.selected}}true{{else}}false{{/if}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="inventory"}}<span>Base</span><small>{{baseFolder.count}}</small></button>
      {{#if elementFolders.length}}<details class="iw-ng-element-folders" data-detail-key="element-folders" {{#if elementFoldersOpen}}open{{/if}}><summary>Elementais</summary>{{#each elementFolders}}<button type="button" data-equipment-folder="{{key}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><span>{{label}}</span><small>{{count}}</small></button>{{/each}}</details>{{/if}}
      <button type="button" data-equipment-folder="armor" aria-pressed="{{#if armorFolder.selected}}true{{else}}false{{/if}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="con"}}<span>Armaduras</span><small>{{armorFolder.count}}</small></button><button type="button" data-equipment-folder="all" aria-pressed="{{#if allFolder.selected}}true{{else}}false{{/if}}"><span>Todos</span><small>{{allFolder.count}}</small></button>
     </nav><div class="iw-ng-equipment-results"><h4 data-equipment-heading>{{folderLabel}}</h4><p class="iw-ng-equipment-count" data-equipment-count aria-live="polite">{{visibleEquipment}} equipamentos</p><div class="iw-ng-equipment-list" data-scroll="equipment-list">{{#each equipmentChoices}}<label class="iw-ng-equipment-card" data-equipment-name="{{name}}" data-equipment-source="{{pack}}" data-equipment-folder="{{folder}}" {{#if hidden}}hidden{{/if}}><input type="checkbox" data-equipment-choice data-focus-key="gear-{{uuid}}" value="{{uuid}}" {{checked selected}}><img src="{{img}}" data-fallback="systems/Immortals-system/icons/svg/items/weapon.svg" alt="" width="56" height="56" loading="lazy"><span><strong title="{{name}}">{{name}}</strong><small title="{{pack}}">{{pack}}</small></span></label>{{/each}}</div><p class="iw-ng-empty" data-equipment-empty {{#if visibleEquipment}}hidden{{/if}}>Nenhum equipamento nesta busca. Ajuste os filtros ou escolha outra pasta.</p></div></div>
    </div>
    <section class="iw-ng-selection"><header><h3>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="inventory"}}Equipamentos escolhidos</h3><span class="iw-ng-selection-count"><strong>{{preview.equipment.length}}</strong> itens</span></header>
    <ul class="iw-ng-gear-list unlist">{{#each preview.equipment}}<li data-gear-uuid="{{uuid}}"><span class="iw-ng-gear-art"><img src="{{img}}" alt="" width="38" height="38"></span><button type="button" class="iw-ng-gear-name" data-action="openSource" data-uuid="{{uuid}}"><strong>{{name}}</strong><small>{{origin}}</small></button><div class="iw-ng-gear-controls"><label class="iw-ng-quantity"><span>Qtd.</span><input type="number" min="1" max="9999" step="1" value="{{quantity}}" data-gear-field="quantity" data-focus-key="quantity-{{uuid}}" aria-label="Quantidade de {{name}}"></label><label class="iw-ng-equipped"><input type="checkbox" data-gear-field="equipped" data-focus-key="equipped-{{uuid}}" {{checked equipped}}><span>Equipado</span></label><button type="button" class="iw-ng-remove" data-action="removeEquipment" data-uuid="{{uuid}}" aria-label="Remover {{name}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="close"}}</button></div></li>{{else}}<li class="iw-ng-empty">Marque os cards acima ou arraste uma arma ou armadura para esta área.</li>{{/each}}</ul></section>
   </section>
   <section id="iw-ng-features-panel" class="iw-ng-feature-panel" role="tabpanel" aria-labelledby="iw-ng-features-tab" data-generator-panel="features" {{#unless featuresPanel}}hidden{{/unless}}><header class="iw-ng-section-heading"><h3>Habilidades da criatura</h3><p>Desmarque as características que esta criatura não terá. As escolhas permanecem ao mudar o cultivo.</p></header><div class="iw-ng-feature-results" data-scroll="features"><ul class="iw-ng-features unlist">{{#each currentFeatures}}<li class="{{#unless available}}iw-ng-unavailable{{/unless}}"><label><input type="checkbox" data-feature="{{uuid}}" data-focus-key="feature-{{uuid}}" {{checked selected}}><img src="{{img}}" alt="" width="36" height="36"><span><strong>{{name}}</strong><small>{{#each profiles}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</small></span></label><button type="button" class="iw-ng-source" data-action="openSource" data-uuid="{{uuid}}" aria-label="Abrir {{name}}" {{disabled (not available)}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}</button>{{#if description}}<details data-detail-key="{{uuid}}" {{#if open}}open{{/if}}><summary>Descrição</summary><p>{{description}}</p></details>{{/if}}</li>{{else}}<li class="iw-ng-empty">{{#if selectedTaxonomy}}Nenhuma habilidade liberada neste estágio.{{else}}Escolha os perfis para revisar as habilidades.{{/if}}</li>{{/each}}</ul>{{#if futureFeatures.length}}<details class="iw-ng-future" {{#if futureOpen}}open{{/if}}><summary>Aprendizados futuros <span>{{futureFeatures.length}}</span></summary><ul class="iw-ng-features unlist">{{#each futureFeatures}}<li><label><input type="checkbox" data-feature="{{uuid}}" data-focus-key="future-{{uuid}}" {{checked allowed}}><img src="{{img}}" alt="" width="36" height="36"><span><strong>{{name}}</strong><small>Nível de cultivo {{minLevel}}</small></span></label><button type="button" class="iw-ng-source" data-action="openSource" data-uuid="{{uuid}}" aria-label="Abrir {{name}}" {{disabled (not available)}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}</button></li>{{/each}}</ul></details>{{/if}}</div></section>
  </div>
 </div>
 {{#if preview.errors.length}}{{#if selectedTaxonomy}}<ul class="iw-ng-validation">{{#each preview.errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}{{/if}}
 {{#if warnings.length}}<details class="iw-ng-warnings"><summary>Avisos dos compêndios</summary>{{#each warnings}}<p>{{this}}</p>{{/each}}</details>{{/if}}
 </div>
 <p class="iw-ng-error" data-generator-error {{#unless errors.length}}hidden{{/unless}} role="alert">{{#each errors}}{{this}}{{/each}}</p>
 <footer class="iw-ng-footer"><span>A criatura começa com Vida e Qi completos.</span><button type="button" data-action="cancel">Cancelar</button><button type="button" class="iw-ng-create" data-action="generate" {{disabled (not canGenerate)}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}Criar PdN</button></footer>
{{else}}<div class="iw-ng-loading"><h2>Preparando o gerador</h2>{{#each errors}}<p role="alert">{{this}}</p>{{else}}<p>Carregando taxonomias e arquétipos dos compêndios…</p>{{/each}}<button type="button" data-action="cancel">Fechar</button></div>{{/if}}
</section>
