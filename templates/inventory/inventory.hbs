<{{ elements.inventory }} class="inventory-element">

    {{!-- Currency --}}
    {{#if showCurrency}}
    {{#if iwInventory}}
    <section class="currency iw-wallet" aria-label="Moedas">
      <header class="iw-wallet-heading">
        <h3>Moedas</h3>
        <p class="iw-currency-rate">1 PO = 10 PS = 100 PC</p>
        {{#unless @root.locked}}<button type="button" class="item-action unbutton always-interactive iw-currency-manage" data-action="currency" aria-label="Gerenciar moedas" data-tooltip="Transferir e converter moedas"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h16m-4-4 4 4-4 4M20 16H4m4-4-4 4 4 4"/></svg></button>{{/unless}}
      </header>
      <div class="iw-currency-fields">
      {{#each currency}}
        {{#with (lookup @root.config.visibleCurrencies @key) as |currency|}}
        <label aria-label="{{ lookup currency 'label' }}" class="iw-currency-field" title="{{localize currency.label}}" data-denomination="{{ @key }}">
          <span class="iw-currency-label">{{#if (and currency.icon (eq currency.exchangeGroup "coins"))}}<img class="iw-currency-art" src="{{currency.icon}}" alt="" aria-hidden="true" width="20" height="20">{{else}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="miter" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9h6v6H9Z"/></svg>{{/if}}<strong>{{ localize currency.abbreviation }}</strong><small>{{#if currency.shortLabel}}{{localize currency.shortLabel}}{{else}}{{localize currency.label}}{{/if}}</small></span>
          <input type="text" class="uninput always-interactive iw-currency-input" name="system.currency.{{ @key }}" value="{{ ../this }}" data-dtype="Number" inputmode="numeric" pattern="^[+=\-]?\d*" {{#if @root.locked}}readonly{{/if}}>
        </label>
        {{/with}}
      {{/each}}
      </div>
    </section>
    {{else}}
    <section class="currency">
        {{#unless @root.locked}}
        <button type="button" class="item-action unbutton always-interactive" data-action="currency"
                aria-label="{{ localize "DND5E.CurrencyManager.Title" }}">
            <i class="fa-solid fa-coins" inert></i>
        </button>
        {{/unless}}
        {{#each currency}}
        {{#with (lookup @root.config.visibleCurrencies @key) as |currency|}}
        <label aria-label="{{ lookup currency 'label' }}" class="jj-yen-label">
            <span class="jj-yen-symbol" data-tooltip="{{ lookup currency 'label' }}">{{localize currency.abbreviation}}</span>
            <input type="text" class="uninput always-interactive jj-yen-input" name="system.currency.{{ @key }}"
                   value="{{ ../this }}" data-dtype="Number" inputmode="numeric" pattern="^[+=\-]?\d*"
                   {{#if @root.locked}}readonly{{/if}}>
        </label>
        {{/with}}
        {{/each}}
    </section>
    {{/if}}
    {{/if}}

    {{!-- Filters --}}
    {{#if listControls}}
    <div class="middle">

        <item-list-controls for="{{ listControls.list }}" collection="items" label="{{ localize listControls.label }}"
                            {{~#if keepEmpty}} keep-empty{{/if}}>

            {{#if listControls.filters.length}}
            <datalist data-list="filters">
                {{#each listControls.filters}}
                <option value="{{ key }}" data-group="{{ group }}" {{ dnd5e-dataset dataset }}>
                    {{ localize label }}
                </option>
                {{/each}}
            </datalist>
            {{/if}}

            {{#if listControls.sorting.length}}
            <datalist data-list="sort">
                {{#each listControls.sorting}}
                <option value="{{ key }}" {{ dnd5e-dataset dataset }}>{{ localize label }}</option>
                {{/each}}
            </datalist>
            {{/if}}

            {{#if listControls.grouping.length}}
            <datalist data-list="group">
                {{#each listControls.grouping}}
                <option value="{{ key }}" {{ dnd5e-dataset dataset }}>{{ localize label }}</option>
                {{/each}}
            </datalist>
            {{/if}}

        </item-list-controls>

    </div>
    {{/if}}

    {{!-- Items --}}
    <section class="items-list {{#if listControls}}{{ listControls.list }}-list{{/if}}"
             {{#if listControls}}data-item-list="{{ listControls.list }}"{{/if}}>

        {{!-- Sections / Categories --}}
        {{#each sections}}
        <div class="items-section card" {{ dnd5e-dataset dataset }} {{#if hidden}}hidden{{/if}} {{#if iwFallback}}data-iw-fallback{{/if}}>

            {{!-- Section Header --}}
            <div class="items-header header {{~#if draggable}} draggable{{/if}}">
                <h3 class="item-name">{{#if ../iwFeatures}}<svg class="iw-feature-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {{#if (eq (lookup dataset "group-origin") "jj-origin")}}<circle cx="12" cy="7" r="3"/><path d="M7 21v-4a5 5 0 0 1 10 0v4M5 10a3 3 0 0 0-2 5v5m16-10a3 3 0 0 1 2 5v5"/>
                  {{else if (eq (lookup dataset "group-origin") "jj-combat")}}<path d="M12 3v18M3 12h18M6 6l12 12M6 18 18 6"/><circle cx="12" cy="12" r="5"/>
                  {{else if (eq (lookup dataset "group-origin") "jj-path")}}<path d="M7 20V9h10V4M4 17l3 3 3-3M14 7l3-3 3 3"/>
                  {{else if (eq (lookup dataset "group-origin") "jj-basic")}}<path d="M12 5C8 2 4 3 2 4v15c3-2 7-2 10 0 3-2 7-2 10 0V4c-2-1-6-2-10 1v14"/>
                  {{else if (eq (lookup dataset "group-origin") "jj-talents")}}<path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/>
                  {{else if (eq (lookup dataset "group-origin") "jj-flaws")}}<path d="m9 3 2 6-4 4 6 8m2-18-2 6 4 4-6 8"/>
                  {{else}}<circle cx="12" cy="4" r="2"/><circle cx="5" cy="20" r="2"/><circle cx="19" cy="20" r="2"/><path d="M12 6v6M5 18v-6h14v6"/>
                  {{/if}}</svg>{{/if}}{{#if @root.iwInventory}}<svg class="iw-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{iwIconPath}}"/></svg>{{/if}}{{ localize label }}{{#if iwDefects}}<span class="iw-defects-count" aria-label="{{iwDefects.count}} de {{iwDefects.max}} Defeitos"><strong>{{iwDefects.count}}</strong><span>/ {{iwDefects.max}}</span></span>{{/if}}</h3>
                {{#each columns}}
                <div class="item-header item-{{ id }}" data-column-id="{{ id }}" data-column-width="{{ width }}"
                     data-column-priority="{{ priority }}">
                    {{~#if label}}{{ localize label }}{{/if~}}
                </div>
                {{/each}}
                {{#if iwDefects}}{{#if @root.owner}}<button type="button" class="iw-defects-add always-interactive" data-action="jj2CustomizationAdd" data-category="jj-flaws" aria-label="Adicionar Defeito" data-tooltip="Adicionar Defeito" {{disabled (not iwDefects.canAdd)}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}</button>{{/if}}{{/if}}
            </div>

            {{#if iwDefects}}<p class="iw-feature-empty">Nenhum Defeito adicionado.{{#if @root.owner}} Arraste um Defeito para cá ou use o botão +.{{/if}}</p>{{/if}}

            {{!-- Section Contents --}}
            <ol class="item-list unlist">
                {{~#each items as |item|}}
                {{#dnd5e-itemContext item as |ctx|}}

                <li class="item collapsible {{#unless ctx.isExpanded}}collapsed{{/unless}}" data-uuid="{{ item.uuid }}"
                    data-item-id="{{ item.id }}" data-entry-id="{{ item.id }}" data-item-name="{{ item.name }}"
                    {{ dnd5e-dataset ctx.dataset }}>

                    {{!-- Row Summary --}}
                    <div class="item-row draggable">

                        {{!-- Item Name --}}
                        <div class="item-name item-action item-tooltip {{#if ctx.clickAction}}{{ @root.rollableClass }}{{/if}}"
                             role="button" data-action="{{ ctx.clickAction }}" aria-label="{{ item.name }}">

                            {{#if ctx.concentration}}
                            <i class="concentration fa-solid fa-arrow-rotate-left fa-spin fa-spin-reverse"
                               aria-label="{{ localize "DND5E.Concentration" }}"></i>
                            {{/if}}

                            {{ dnd5e-icon item.img alt=item.name classes="item-image gold-icon" }}

                            <div class="name name-stacked">
                                <span class="title">{{ item.name }}</span>
                                {{#if ctx.subtitle}}
                                <span class="subtitle">{{{ ctx.subtitle }}}</span>
                                {{/if}}
                                {{#if ctx.armorRarity}}<span class="iw-armor-rarity-tag {{#unless ctx.armorRarity.level}}iw-unassigned{{/unless}}" title="{{ctx.armorRarity.title}}">{{ctx.armorRarity.label}}</span>{{/if}}
                            </div>

                            <div class="tags">
                                {{#if item.labels.components}}
                                {{#each item.labels.components.all}}
                                {{#if tag}}
                                <span aria-label="{{ label }}">
                                    <dnd5e-icon src="{{ icon }}"></dnd5e-icon>
                                </span>
                                {{/if}}
                                {{/each}}
                                {{else}}
                                {{#each item.labels.properties}}
                                {{#if icon}}
                                <span aria-label="{{ label }}">
                                    <dnd5e-icon src="{{ icon }}"></dnd5e-icon>
                                </span>
                                {{/if}}
                                {{/each}}
                                {{/if}}
                            </div>

                        </div>

                        {{!-- Columns --}}
                        {{#if ctx.columns.length}}
                        {{!-- Column overrides for an individual item --}}
                        {{#each ctx.columns}}
                        {{> (lookup . "template") entry=item item=item ctx=ctx isItem=true }}
                        {{/each}}
                        {{else}}
                        {{!-- Otherwise use the columns defined in the section --}}
                        {{#each ../columns}}
                        {{> (lookup . "template") entry=item item=item ctx=ctx isItem=true }}
                        {{/each}}
                        {{/if}}

                    </div>

                    {{!-- Extended Description & Activities --}}
                    <div class="item-description collapsible-content">
                        <div class="wrapper">

                            {{!-- Activities --}}
                            {{#if ctx.activities.length}}
                            <ol class="activities unlist">
                                {{#each ctx.activities}}
                                {{> "systems/Immortals-system/templates/inventory/activity.hbs" columns=../../columns
                                    item=../item }}
                                {{/each}}
                            </ol>
                            {{/if}}

                            {{!-- Item Description --}}
                            {{#if ctx.isExpanded}}
                            {{> "dnd5e.item-summary" ctx.expanded }}
                            {{/if}}

                        </div>
                    </div>

                </li>

                {{/dnd5e-itemContext}}
                {{/each~}}
            </ol>
            {{#if @root.iwInventory}}<p class="iw-inventory-empty">Nenhum item exibido.</p>{{/if}}
            {{#if ../iwFeatures}}<p class="iw-feature-empty">Nenhuma característica nesta categoria.</p>{{/if}}

        </div>
        {{/each}}

    </section>

    {{!-- Encumbrance --}}
    {{#if encumbrance}}
    <div class="bottom">
        <div class="encumbrance">
            {{> "systems/Immortals-system/templates/inventory/encumbrance.hbs" hasBreakpoints=true }}
        </div>
    </div>
    {{/if}}

</{{ elements.inventory }}>
