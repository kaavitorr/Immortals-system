{{#if immortalsRest}}
<section class="iw-long-rest">
  <header class="iw-rest-intro"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.1A8.5 8.5 0 0 1 9.9 4a8.5 8.5 0 1 0 10.1 10.1Z"/><path d="M17 3v4m-2-2h4"/></svg><div><h2>Recuperação do descanso</h2><p>{{#if isGroup}}Cada participante recupera suas reservas conforme as próprias características.{{else}}Trate as Feridas e restaure sua Vida e seu Qi.{{/if}}</p></div></header>
  {{#if recovery}}
  <div class="iw-rest-recoveries" aria-live="polite">
    {{#if recovery.woundsApplicable}}
    <article class="iw-rest-recovery iw-rest-wounds"><header><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 3 14 14-4 4L3 7l4-4Zm10 0 4 4L7 21l-4-4L17 3Z"/><path d="M10 10h.01m4 0h.01m-4 4h.01m4 0h.01"/></svg><div><h3 class="iw-rest-card-title">Feridas</h3><p>Recupera <span data-rest-preview="woundsRate">{{recovery.woundsRate}}</span> das Feridas atuais</p></div><strong class="iw-rest-amount" data-rest-preview="woundsAmount">{{recovery.woundsAmount}}</strong></header><footer><span>Antes: <b data-rest-preview="woundsBefore">{{recovery.woundsBefore}}</b></span><span>Após o descanso: <b data-rest-preview="woundsAfter">{{recovery.woundsAfter}}</b></span></footer></article>
    {{/if}}
    <article class="iw-rest-recovery iw-rest-life"><header><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 4.5a5 5 0 0 0-7 0L12 6l-1.5-1.5a5 5 0 0 0-7 7L12 20l8.5-8.5a5 5 0 0 0 0-7Z"/></svg><div><h3 class="iw-rest-card-title">Pontos de Vida</h3><p>Recuperação completa</p></div><strong class="iw-rest-amount" data-rest-preview="lifeFinal">{{recovery.lifeFinal}}</strong></header><footer><span>Antes: <b data-rest-preview="lifeBefore">{{recovery.lifeBefore}}</b> PV</span><span><b data-rest-preview="lifeGain">{{recovery.lifeGain}}</b> PV</span></footer></article>
    <article class="iw-rest-recovery iw-rest-qi"><header><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20C6 20 3 16 3 11c4 0 7 2 9 6 2-4 5-6 9-6 0 5-3 9-9 9Z"/><path d="M12 17c-5-4-4-9 0-14 4 5 5 10 0 14Z"/></svg><div><h3 class="iw-rest-card-title">Pontos de Qi</h3><p>Recuperação completa</p></div><strong class="iw-rest-amount" data-rest-preview="qiFinal">{{recovery.qiFinal}}</strong></header><footer><span>Antes: <b data-rest-preview="qiBefore">{{recovery.qiBefore}}</b> Qi</span><span><b data-rest-preview="qiGain">{{recovery.qiGain}}</b> Qi</span></footer></article>
  </div>
  {{#if recovery.exhaustionApplicable}}<p class="iw-rest-ceiling-note">Exaustão do Vortex: recupera <strong data-rest-preview="exhaustionGain">{{recovery.exhaustionGain}}</strong> nível neste descanso · <strong data-rest-preview="exhaustionRemaining">{{recovery.exhaustionRemaining}}</strong> restante(s). Exige descanso longo de pelo menos <strong data-rest-preview="exhaustionHours">{{recovery.exhaustionHours}}</strong> horas; recupera um nível por descanso.</p>{{/if}}
  {{#if recovery.constitutionApplicable}}<p class="iw-rest-ceiling-note">Recuperação em Massa: <strong data-rest-preview="constitutionGain">{{recovery.constitutionGain}}</strong> Constituição neste descanso · <strong data-rest-preview="constitutionRemaining">{{recovery.constitutionRemaining}}</strong> ponto(s) pendente(s). Limite de 1 ponto por dia.</p>{{/if}}
  <p class="iw-rest-ceiling-note">A Vida é restaurada até o limite resultante das Feridas restantes.</p>
  {{else}}
  <div class="iw-rest-general"><p><strong>Feridas</strong><span>Recuperação conforme o Caminho do Corpo de cada participante.</span></p><p><strong>Vida</strong><span>Todos os Pontos de Vida, até o limite após recuperar Feridas.</span></p><p><strong>Qi</strong><span>Todos os Pontos de Qi.</span></p></div>
  {{/if}}
  {{#if formSections.length}}<details class="iw-rest-options"><summary>Opções do descanso<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div>{{> "dnd5e.formlist" formSections}}</div></details>{{/if}}
  {{#if request}}{{> "systems/Immortals-system/templates/actors/rest/parts/rest-request.hbs"}}{{/if}}
</section>
{{else}}
<section class="flexcol"><div class="note info">{{localize (ifThen isGroup "DND5E.REST.Long.Hint.Group" "DND5E.REST.Long.Hint.Normal")}}</div>{{> "dnd5e.formlist" formSections}}{{#if request}}{{> "systems/Immortals-system/templates/actors/rest/parts/rest-request.hbs"}}{{/if}}</section>
{{/if}}
