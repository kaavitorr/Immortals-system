<nav class="jj2-tabs-nav tabs" data-group="primary" aria-label="Abas da ficha">
  {{#each tabs}}<button type="button" class="item always-interactive {{#if active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{ id }}" data-label="{{ label }}" data-tooltip="{{ label }}" data-tooltip-direction="RIGHT" aria-label="{{ label }}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{#with (lookup @root.jj2.tabImages id) as |image|}}<img class="iw-tab-art" src="{{ image }}" alt="" aria-hidden="true" width="28" height="28" draggable="false">{{else}}{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key=icon }}{{/with}}</button>{{/each}}
</nav>
