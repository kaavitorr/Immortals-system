<section class="tab {{tab.cssClass}} jj2-page iw-professions iw-professions-content" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="iw-tab-heading iw-professions-heading">
    <h2>{{#with jj2.tabImages.professions as |image|}}<img class="iw-tab-heading-art" src="{{image}}" alt="" aria-hidden="true" width="28" height="28" draggable="false">{{else}}{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="professions"}}{{/with}}Profissão</h2>
    <div class="iw-profession-global-state">
      {{#unless professions.toxins.hidden}}<span><strong>{{professions.pcAvailable}}</strong> PC disponíveis</span>{{/unless}}
      {{#if professions.editable}}<button type="button" class="iw-profession-catalog-action" data-action="professionToxins">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="wounds"}}<span>Toxinas e remoção</span><strong>{{professions.toxins.displayLabel}}</strong></button>{{/if}}
    </div>
  </div>
  {{#if professions.rankDifficultyReduction}}<p class="iw-profession-rank-benefit">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="cultivation"}}<span><strong>Benefícios de cultivo</strong> · −{{professions.rankDifficultyReduction}} à CD de criações de nível 5 ou abaixo. {{#if professions.higherDifficultyReduction}}−{{professions.higherDifficultyReduction}} à CD acima do nível 5.{{/if}} Considere esses bônus ao resolver seus projetos.</span></p>{{/if}}
  <nav class="iw-profession-tabs" role="tablist" aria-label="Ofícios">
    {{#each professions.items}}<button type="button" class="iw-profession-tab always-interactive {{#if active}}active{{/if}}" id="{{@root.rootId}}-profession-tab-{{key}}" role="tab" data-profession-tab="{{key}}" aria-controls="{{@root.rootId}}-profession-panel-{{key}}" aria-selected="{{#if active}}true{{else}}false{{/if}}" tabindex="{{#if active}}0{{else}}-1{{/if}}">{{> "systems/Immortals-system/templates/actors/parts/profession-icon.hbs" key=key painted=true}}<span>{{label}}</span></button>{{/each}}
  </nav>
  {{#each professions.items}}
  <div class="iw-profession-workspace" data-profession="{{key}}" data-profession-panel="{{key}}" id="{{@root.rootId}}-profession-panel-{{key}}" role="tabpanel" aria-labelledby="{{@root.rootId}}-profession-tab-{{key}}" aria-hidden="{{#if active}}false{{else}}true{{/if}}" {{#unless active}}hidden{{/unless}}>
    <header class="iw-profession-hero">
      <div class="iw-profession-hero-copy">
        <div class="iw-profession-title-line"><div class="iw-profession-level-medallion" aria-label="{{levelLabel}}"><span>Nível</span><strong>{{level}}</strong></div><div><h2>{{title}}</h2><p class="iw-profession-rank-label">{{rankLabel}}</p></div></div>
        <p>{{description}}</p>
        <div class="iw-profession-hero-actions">{{#if @root.professions.editable}}<button type="button" class="iw-profession-catalog-action" data-action="professionConfigure">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config"}}<span>Configurar nível</span></button>{{/if}}<button type="button" class="iw-profession-catalog-action always-interactive" data-action="professionRules">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="int"}}<span>Regras do ofício</span></button></div>
      </div>
      <div class="iw-profession-hero-art">{{> "systems/Immortals-system/templates/actors/parts/profession-art.hbs" key=key}}</div>
    </header>
    <ol class="iw-profession-level-gallery" aria-label="Níveis profissionais">{{#each levelGallery}}<li class="{{#if attained}}attained{{/if}} {{#if current}}current{{/if}} {{#if next}}next{{/if}}" title="Nível {{level}}: {{rankLabel}}" aria-label="Nível {{level}}: {{rankLabel}}{{#if current}}, atual{{else if next}}, próximo{{/if}}"><strong>{{level}}</strong><span>{{#if current}}Atual{{else if next}}Próximo{{else}}&nbsp;{{/if}}</span></li>{{/each}}</ol>
    <div class="iw-profession-study-line"><span><strong>Talento:</strong> {{requiredTalent}}</span>{{#each extraRequirements}}<span>{{this}}</span>{{/each}}</div>
    <details class="iw-profession-kit"><summary>Requisitos e ferramentas <span>{{toolCount}} referências</span></summary><div class="iw-profession-kit-content"><div><h3>Para ingressar</h3><ul>{{#each requirements}}<li>{{this}}</li>{{/each}}</ul><p>Confirme esses requisitos ao realizar o ingresso.</p></div><div><h3>Ferramentas e estudo</h3><ul class="iw-profession-tool-list">{{#each tools}}<li><span class="iw-profession-tool-quantity">{{quantityLabel}}</span><button type="button" class="always-interactive" data-action="professionOpenProduct" data-product="{{id}}">{{name}}</button></li>{{/each}}</ul></div></div></details>
    {{#if refinedEquipment}}
    <section class="iw-refinement-reference" aria-label="Equipamentos refinados">
      <header><h3>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="professions"}}Equipamentos refinados</h3><span>Regras por rank do tesouro</span></header>
      <details open><summary>Armas <span>Dano e Explosão Ofensiva</span></summary>
        <table><thead><tr><th>Rank</th><th>Dano base</th><th>Limite de Explosão Ofensiva</th></tr></thead><tbody>{{#each refinedEquipment}}<tr><th scope="row">{{rank}}</th><td class="iw-refined-numeric">{{weapon.formula}}</td><td class="iw-refined-numeric">+{{weapon.offensiveBurstLimitBonus}} PQ</td></tr>{{/each}}</tbody></table>
      </details>
      <details><summary>Armaduras <span>Resistência e proteção por reino</span></summary>
        <table><thead><tr><th>Rank</th><th>Resistência a todos</th><th>Proteção adicional</th></tr></thead><tbody>{{#each refinedEquipment}}<tr><th scope="row">{{rank}}</th><td class="iw-refined-numeric">{{armor.resistanceAll}}</td><td>{{armorProtectionLabel}}</td></tr>{{/each}}</tbody></table>
        <p>A raridade também acrescenta +1 à CR natural da armadura por nível do tesouro.</p>
      </details>
    </section>
    {{/if}}
    {{#if isAlchemy}}<section class="iw-profession-toxicity" aria-label="Toxicidade de pílulas"><div class="iw-profession-toxicity-title"><h3>Toxinas de pílula</h3><strong>{{@root.professions.toxins.displayLabel}} <span>/ 100</span></strong><span class="iw-profession-toxicity-status {{#if @root.professions.toxins.blockedUntilClear}}blocked{{/if}}">{{@root.professions.toxins.statusLabel}}</span></div><div class="iw-profession-toxin-meter" role="img" aria-label="{{@root.professions.toxins.displayLabel}} pontos de toxina"><span style="width:{{@root.professions.toxins.meterPercent}}%"></span></div><div class="iw-profession-toxicity-details"><span>Rank: +{{@root.professions.toxins.penalties.rankDC}} CD e +{{@root.professions.toxins.penalties.rankPC}} PC</span><span>Etapa: +{{@root.professions.toxins.penalties.stagePC}} PC</span><span>{{@root.professions.toxins.detoxLabel}}</span></div></section>{{/if}}
    {{#if isBeasts}}<section class="iw-profession-beast-work"><div>{{> "systems/Immortals-system/templates/actors/parts/profession-icon.hbs" key="beasts"}}<div><h3>Domesticação e crescimento</h3><p>Acompanhe o Rank atual, o potencial adulto e as tentativas de cada besta.</p></div></div>{{#if @root.professions.editable}}<button type="button" class="iw-profession-catalog-action" data-action="professionBeast">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}<span>Domar / acompanhar</span></button>{{/if}}</section>{{/if}}
    {{#if hasProducts}}<section class="iw-profession-catalog" aria-label="Catálogo de {{title}}">
      <header class="iw-profession-catalog-heading"><div><h3>Catálogo do ofício</h3><span data-profession-filter-count aria-live="polite">{{productCount}} produtos</span></div><label class="iw-profession-search"><span class="iw-profession-search-label">Buscar no catálogo</span><input type="search" class="always-interactive" data-profession-search placeholder="{{searchPlaceholder}}" autocomplete="off" aria-label="Buscar no catálogo de {{title}}"></label></header>
      {{#each productGroups}}<section class="iw-profession-product-group" data-profession-product-group><header><h4>{{label}}</h4><span data-profession-group-count>{{count}}</span></header><div class="iw-profession-product-grid">{{#each items}}<article class="iw-profession-product" data-profession-product data-product-search="{{searchText}}"><img class="iw-profession-product-art" src="{{image}}" alt="" width="56" height="56" loading="lazy"><div class="iw-profession-product-copy"><h4>{{name}}</h4><div class="iw-profession-product-meta"><span>{{levelRangeLabel}}</span><span>{{dcLabel}}</span>{{#if toxinLabel}}<span>{{toxinLabel}}</span>{{/if}}</div><p>{{summary}}</p><div class="iw-profession-product-actions"><button type="button" class="iw-profession-catalog-action always-interactive" data-action="professionOpenProduct" data-product="{{id}}" aria-label="Ver {{name}}">Ver</button>{{#if @root.professions.editable}}{{#if canCraft}}<button type="button" class="iw-profession-catalog-action iw-profession-produce" data-action="professionCraft" data-product="{{id}}" aria-label="Produzir {{name}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="dice"}}<span>Produzir</span></button>{{else}}<span class="iw-profession-product-availability">{{eligibilityLabel}}</span>{{/if}}{{/if}}{{#if hasPendingEffect}}<span class="iw-profession-product-availability">Efeito pendente</span>{{/if}}</div></div></article>{{/each}}</div></section>{{/each}}
      <p class="iw-profession-search-empty" data-profession-search-empty hidden>Nenhum produto corresponde à busca.</p>
    </section>{{/if}}
    <div class="iw-profession-ledger-label"><h3>Registros pessoais</h3><span>{{counts.projects}} projetos e {{counts.references}} no acervo</span></div>
    <div class="iw-profession-columns"><div class="iw-profession-ledgers">
      <section class="iw-profession-panel iw-profession-projects"><header class="iw-profession-panel-heading"><h3>{{> "systems/Immortals-system/templates/actors/parts/profession-icon.hbs" key=key}}{{projectsTitle}}</h3>{{#if @root.professions.editable}}<button type="button" class="iw-profession-add" data-action="professionAddRecord" data-kind="project">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}<span>{{projectAction}}</span></button>{{/if}}</header>
        {{#if hasProjects}}<ol class="iw-profession-records">{{#each projects}}<li class="iw-profession-record" data-status="{{status}}"><div class="iw-profession-record-copy"><button type="button" class="iw-profession-record-name always-interactive" data-action="professionOpenRecord" data-record="{{id}}" title="{{name}}">{{name}}</button>{{#if summary}}<p title="{{summary}}">{{summary}}</p>{{/if}}</div><div class="iw-profession-record-tools">{{#if @root.professions.editable}}<select class="iw-profession-status" data-profession-status="{{id}}" aria-label="Situação de {{name}}">{{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><button type="button" class="iw-profession-icon-button" data-action="professionDeleteRecord" data-record="{{id}}" aria-label="Remover {{name}}" data-tooltip="Remover registro">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="delete"}}</button>{{else}}<span class="iw-profession-status-label" data-status="{{status}}">{{statusLabel}}</span>{{/if}}</div></li>{{/each}}</ol>{{else}}<div class="iw-profession-empty"><div class="iw-profession-empty-mark">{{> "systems/Immortals-system/templates/actors/parts/profession-icon.hbs" key=key}}</div><strong>A área de trabalho está livre</strong><p>Registre uma criação para acompanhar suas etapas e os detalhes do trabalho.</p></div>{{/if}}
      </section>
      <section class="iw-profession-panel iw-profession-library"><header class="iw-profession-panel-heading"><h3>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="int"}}{{referencesTitle}}</h3>{{#if @root.professions.editable}}<button type="button" class="iw-profession-add" data-action="professionAddRecord" data-kind="reference">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}<span>{{referenceAction}}</span></button>{{/if}}</header>
        {{#if hasReferences}}<ol class="iw-profession-records">{{#each references}}<li class="iw-profession-record"><div class="iw-profession-record-copy"><button type="button" class="iw-profession-record-name always-interactive" data-action="professionOpenRecord" data-record="{{id}}" title="{{name}}">{{name}}</button>{{#if summary}}<p title="{{summary}}">{{summary}}</p>{{/if}}</div><div class="iw-profession-record-tools">{{#if @root.professions.editable}}<button type="button" class="iw-profession-start" data-action="professionStartProject" data-record="{{id}}" data-tooltip="Usar este registro para iniciar um projeto">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}<span>Iniciar</span></button><button type="button" class="iw-profession-icon-button" data-action="professionDeleteRecord" data-record="{{id}}" aria-label="Remover {{name}}" data-tooltip="Remover registro">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="delete"}}</button>{{/if}}</div></li>{{/each}}</ol>{{else}}<div class="iw-profession-empty iw-profession-empty-library"><strong>Seu conhecimento começa aqui</strong><p>Guarde os métodos, fórmulas e descobertas que fazem parte deste ofício.</p></div>{{/if}}
      </section>
    </div><aside class="iw-profession-panel iw-profession-notebook"><header class="iw-profession-panel-heading"><h3>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="personalization"}}Caderno de ofício</h3></header>
      <div class="iw-profession-profile"><label><span>Especialidade</span><input type="text" data-profession-field="specialty" value="{{profile.specialty}}" placeholder="{{specialtyPlaceholder}}" {{disabled (not @root.professions.editable)}}></label><label><span>Mentor ou tradição</span><input type="text" data-profession-field="tradition" value="{{profile.tradition}}" placeholder="Quem ensinou este ofício" {{disabled (not @root.professions.editable)}}></label><label class="iw-profession-notes"><span>Estudos e anotações</span><textarea data-profession-field="notes" rows="7" placeholder="Métodos, descobertas e observações…" {{disabled (not @root.professions.editable)}}>{{profile.notes}}</textarea></label></div>
    </aside></div>
  </div>
  {{/each}}
</section>
