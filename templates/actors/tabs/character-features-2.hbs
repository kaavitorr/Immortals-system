<section class="tab {{ tab.cssClass }} jj2-page jj2-features" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  <header class="jj2-page-heading iw-tab-heading jj2-features-heading">
    <h2>{{#with jj2.tabImages.features as |image|}}<img class="iw-tab-heading-art" src="{{image}}" alt="" aria-hidden="true" width="28" height="28" draggable="false">{{else}}{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="tree" }}{{/with}}Características</h2>
    <div class="iw-features-actions">
      <button type="button" class="iw-features-map {{#if owner}}always-interactive{{/if}}" data-action="jj2SkillTree" {{ disabled (not owner) }}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="tree" }}Mapa de Características</button>
      {{#if owner}}<button type="button" class="iw-features-add always-interactive" data-action="addDocument" aria-label="Adicionar característica">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add" }}Adicionar</button>{{/if}}
    </div>
  </header>
  {{> "systems/Immortals-system/templates/actors/parts/practice-evolution.hbs" }}
  {{> "systems/Immortals-system/templates/inventory/inventory.hbs" iwFeatures=true }}
</section>
