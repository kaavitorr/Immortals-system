<section class="tab {{tab.cssClass}} jj2-page jj2-summary jj2-npc-summary" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="iw-martial-overview"><div class="jj2-combat-metrics">
    <div class="jj2-metric jj2-metric-resistance">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="con"}}<strong>{{system.attributes.ac.value}}</strong><span class="jj2-metric-label">Classe de Resistência</span>{{#if editable}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="armorClass" aria-label="Configurar Classe de Resistência">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button>{{/if}}</div>
    <div class="jj2-metric jj2-metric-movement">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="dex"}}<strong>{{jj2.movement.value}} <small>{{jj2.movement.unit}}</small></strong><span class="jj2-metric-label">{{#if jj2.movement.voando}}Voo{{else}}Movimento{{/if}}</span>{{#if editable}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="movement" aria-label="Configurar Movimento">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button>{{/if}}</div>
    <button type="button" class="jj2-metric jj2-metric-initiative {{rollableClass}} {{#if owner}}always-interactive{{/if}}" data-action="roll" data-type="initiative" aria-label="Rolar Iniciativa" {{disabled (not owner)}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}<strong>{{dnd5e-formatModifier system.attributes.init.total}}</strong><span class="jj2-metric-label">Iniciativa</span></button>
    <div class="jj2-metric jj2-engagement">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="cha"}}{{#if editable}}<input type="number" name="system.legacy2.engagement" value="{{jj2.engagementBase}}" min="0" data-dtype="Number" placeholder="{{jj2.engagement}}" aria-label="Engajamento">{{else}}<strong>{{jj2.engagement}}</strong>{{/if}}<span class="jj2-metric-label">Engajamento</span></div>
    <div class="jj2-metric jj2-metric-technique-dc" data-tooltip="{{jj2.techniqueDC.tooltip}}" aria-label="CD das técnicas">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="fulgor"}}<strong>{{jj2.techniqueDC.value}}</strong><span class="jj2-metric-label">CD das Técnicas</span></div>
  </div></div>
  <div class="jj2-panel jj2-npc-classification"><h2>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="summary"}}Perfil da Ameaça</h2>
    {{#if editable}}<div class="jj2-npc-fields">
      <div class="iw-npc-cultivation-fields"><label>Reino de Cultivo<select data-npc-cultivation-rank aria-label="Reino de Cultivo do PdN">{{#each jj2.npc.cultivationRanks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Estágio<select data-npc-cultivation-stage aria-label="Estágio de cultivo do PdN">{{#each jj2.npc.cultivationStages}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
      <label>Natureza<select name="flags.Immortals-system.npcNature" aria-label="Natureza do NPC">{{#each jj2.npc.natureOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Cultivo da Alma<select data-npc-soul-cultivation aria-label="Cultivo da Alma do PdN">{{#each jj2.npc.soulCultivationOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>Classificação<select name="system.legacy2.categoria" aria-label="Classificação de Existência">{{#each jj2.npc.categories}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    </div><p class="jj2-npc-note">Crie os itens de Taxonomia e Arquétipo na lista de Itens e arraste para esta ficha. Eles aparecem como tags abaixo do nome; clique na tag para editar o perfil aplicado.</p>{{/if}}
    {{#unless editable}}<p class="jj2-npc-note">Natureza: <strong>{{jj2.npc.natureLabel}}</strong></p>{{/unless}}
    <p class="jj2-npc-note">Classificação de Existência: <strong>{{jj2.npc.category}}</strong> · {{jj2.npc.classificationHp}}× PV · {{jj2.npc.classificationActions}} Pontos de Ação por rodada.</p>
    {{#if jj2.npc.distribution}}<div class="jj2-npc-distribution"><header><strong>{{jj2.npc.distribution.initialPoints}} iniciais <span>+ {{jj2.npc.distribution.growthPoints}} por nível de cultivo</span></strong><span>{{jj2.npc.distribution.budget}} pontos</span></header><div class="jj2-npc-distribution-values">{{#each jj2.npc.distribution.rows}}<div title="Inicial {{initial}} + crescimento {{growth}}"><span>{{localize label}}</span><strong>{{initial}}<small> +{{growth}}</small></strong></div>{{/each}}</div>{{#if jj2.npc.distribution.unspent}}<p>{{jj2.npc.distribution.unspent}} ponto(s) de crescimento não aplicado(s). Confira o Arquétipo e o limite de 12 por atributo.</p>{{/if}}</div>{{else}}{{#if jj2.npc.archetype}}<p class="jj2-npc-note">Arraste um item de Taxonomia para distribuir os pontos iniciais e aplicar o crescimento do Arquétipo.</p>{{/if}}{{/if}}
    {{#if itemCategories.classes}}<div class="jj2-npc-profile jj2-npc-styles">{{#each itemCategories.classes}}<button type="button" class="jj2-action always-interactive item-tooltip" data-action="showDocument" data-item-id="{{id}}" data-uuid="{{uuid}}"><img src="{{img}}" alt="">{{name}}</button>{{/each}}</div>{{/if}}
    {{#if editable}}<details class="jj2-npc-native-details"><summary>Dados da criatura</summary><div class="jj2-npc-fields"><label>Tamanho<select name="system.traits.size">{{selectOptions CONFIG.actorSizes selected=source.traits.size labelAttr="label"}}</select></label><label>Tipo<button type="button" class="jj2-action" data-action="showConfiguration" data-config="creatureType">{{system.details.type.label}}{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config"}}</button></label><label>Alinhamento<input type="text" name="system.details.alignment" value="{{source.details.alignment}}"></label></div></details>{{else}}<p class="jj2-npc-note">{{lookup (lookup CONFIG.actorSizes system.traits.size) "label"}} {{system.details.type.label}} {{system.details.alignment}}</p>{{/if}}
  </div>
  {{#if editable}}<div class="jj2-panel jj2-npc-energy-settings"><h2>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy"}}Configuração de Qi</h2><div class="jj2-npc-fields"><label>Reserva máxima{{#if jj2.npc.hasTaxonomy}}<strong>{{system.energy.max}}</strong>{{else}}<input type="number" name="system.energy.max" value="{{source.energy.max}}" min="0" data-dtype="Number">{{/if}}</label><label>Limite de Qi Refinado<input type="number" name="system.energy.genMax" value="{{source.energy.genMax}}" min="0" data-dtype="Number"></label><label>Qi Refinado por turno<input type="number" name="system.energy.genPerTurn" value="{{source.energy.genPerTurn}}" min="0" data-dtype="Number"></label></div></div>{{/if}}
  <div class="jj2-panel jj2-npc-armor"><h2>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="con"}}Proteção</h2><div class="jj2-npc-shield-settings"><span>Escudo máximo <strong>{{system.armorPoints.max}}</strong></span>{{#if editable}}<button type="button" class="jj2-action" data-action="showConfiguration" data-config="armorPoints" aria-label="Configurar Escudo">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config"}}Configurar</button>{{/if}}</div>
    {{#if editable}}<div class="jj2-npc-temp-fields"><label>Vida temporária<input type="number" name="system.attributes.hp.temp" value="{{source.attributes.hp.temp}}" min="0" data-dtype="Number"></label><label>Ajuste de Vida máxima<input type="number" name="system.attributes.hp.tempmax" value="{{source.attributes.hp.tempmax}}" data-dtype="Number"></label></div>{{/if}}
  </div>
  <details class="jj2-panel jj2-npc-proficiency-panel" {{#if editable}}open{{/if}}><summary>Progressão de Proficiência <span>{{jj2.npc.proficiency.allocated}} / {{jj2.npc.proficiency.budget}}</span></summary>
    <p class="jj2-npc-note">1 ponto por nível de cultivo adicional, em rodízio pela ordem abaixo. Os ajustes manuais nas bolinhas de proficiência são somados ao crescimento automático, até Mestre.</p>
    {{> "systems/Immortals-system/templates/actors/parts/jj2-proficiency-order.hbs" order=jj2.npc.proficiency}}
  </details>
  <div class="jj2-panel jj2-saves"><div class="jj2-saves-heading"><h2>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="con"}}Salvaguardas</h2></div>{{#if jj2.alternativeSaves}}{{> "systems/Immortals-system/templates/actors/parts/jj2-alternative-saves.hbs" }}{{else}}<ul>
    {{#each jj2.saves}}<li class="jj2-rank-row" data-key="{{key}}" data-ability="{{key}}"><div class="jj2-rank-name">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key=key}}<a class="saving-throw {{@root.rollableClass}}" data-action="roll" data-type="ability">{{label}}</a></div><div class="jj2-rank-line">{{> "systems/Immortals-system/templates/actors/parts/jj2-ranks.hbs" ctx="saves"}}<strong>{{dnd5e-formatModifier total}}</strong></div><small>{{rankLabel}}</small></li>{{/each}}
  </ul>{{/if}}</div>
  {{> "systems/Immortals-system/templates/actors/parts/jj2-resistances.hbs" }}
  {{#if showDeathSaves}}<div class="jj2-panel jj2-npc-death"><h2><button type="button" class="jj2-action always-interactive" data-action="roll" data-type="deathSave">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="dice"}}Teste de Morte</button></h2><div class="jj2-npc-temp-fields"><label>Sucessos<input type="number" name="system.attributes.death.success" value="{{system.attributes.death.success}}" min="0" max="3" data-dtype="Number"></label><label>Falhas<input type="number" name="system.attributes.death.failure" value="{{system.attributes.death.failure}}" min="0" max="3" data-dtype="Number"></label></div></div>{{/if}}
  {{#if showLoyalty}}<div class="jj2-panel"><h2>Lealdade</h2>{{#if editable}}<input type="number" name="system.attributes.loyalty.value" value="{{source.attributes.loyalty.value}}" data-dtype="Number" aria-label="Lealdade">{{else}}<strong>{{system.attributes.loyalty.value}}</strong>{{/if}}</div>{{/if}}
</section>
