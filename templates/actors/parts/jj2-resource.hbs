<div class="jj2-resource {{#if sigil}}jj2-resource-sigil{{/if}} {{#if (and health tempValue)}}jj2-has-temp-hp{{/if}}" data-resource="{{ id }}">
  <div class="jj2-resource-heading"><label for="{{ @root.rootId }}-jj2-{{ id }}">{{#if icon}}{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key=icon }}{{/if}}{{ label }}</label>
    {{#if (and @root.editable configKey)}}<button type="button" class="jj2-config" data-action="showConfiguration" data-config="{{ configKey }}" aria-label="Configurar {{ label }}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="config" }}</button>{{/if}}
    {{#if (and @root.owner action)}}<button type="button" class="jj2-config always-interactive" data-action="{{ action }}" aria-label="{{ actionLabel }}" data-tooltip="{{ actionLabel }}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy" }}</button>{{/if}}
    {{#if (and health tempValue)}}<span class="jj2-temp-hp-note" title="{{ tempValue }} Pontos de Vida Temporários">+{{ tempValue }} temp.</span>{{/if}}
  </div>
  <div class="jj2-resource-values">
    {{#if sigil}}<button type="button" class="jj2-refine-sigil {{#if @root.owner}}always-interactive{{/if}}" data-action="jj2RefineEnergy" aria-label="{{#if sigilLabel}}{{sigilLabel}}{{else}}Refinar Energia{{/if}}" data-tooltip="{{#if sigilLabel}}{{sigilLabel}}{{else}}Refinar Energia{{/if}}" {{ disabled (not @root.owner) }}>{{#if sigilLotus}}<img class="jj2-aura-sigil iw-qi-lotus" src="systems/Immortals-system/assets/wuxia/refinement-lotus-v4.webp" alt="" aria-hidden="true">{{else}}<img class="jj2-aura-sigil" src="{{#if sigilImage}}{{sigilImage}}{{else}}systems/Immortals-system/assets/ficha/energia-amaldicoada-outline.webp{{/if}}" alt="" aria-hidden="true">{{/if}}</button>{{/if}}
    <input id="{{ @root.rootId }}-jj2-{{ id }}" type="number" name="{{ path }}" value="{{ value }}" min="0" {{#if health}}data-hp-total="{{ value }}"{{/if}} {{#unless unbounded}}max="{{ max }}"{{/unless}} data-dtype="Number" aria-label="{{ label }}{{#if health}} total, incluindo temporários{{else}} atual{{/if}}" class="{{#if @root.owner}}always-interactive{{/if}}" {{ disabled (not @root.owner) }}><span>/ {{ max }}</span>
  </div>
  {{#if hint}}<small>{{ hint }}</small>{{/if}}
  {{#if (and health tempValue)}}<div class="jj2-meter jj2-temp-hp-meter" role="meter" aria-label="Pontos de Vida Temporários" aria-valuemin="0" aria-valuenow="{{ tempValue }}" aria-valuemax="{{ tempMax }}" title="{{ tempValue }} Pontos de Vida Temporários"><span style="width:{{ tempPct }}%"></span><svg class="iw-resource-cap iw-resource-cap-start" viewBox="0 0 8 14" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width=".9" aria-hidden="true" focusable="false"><path d="M8 .5H3.5L.5 3.5v7l3 3H8M5 4H3.5v6H5" vector-effect="non-scaling-stroke"/></svg><svg class="iw-resource-cap iw-resource-cap-end" viewBox="0 0 8 14" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width=".9" aria-hidden="true" focusable="false"><path d="M8 .5H3.5L.5 3.5v7l3 3H8M5 4H3.5v6H5" vector-effect="non-scaling-stroke"/></svg></div>{{/if}}
  {{#unless pipsMode}}<div class="jj2-meter {{#if health}}jj2-normal-hp-meter{{/if}}" role="meter" aria-label="{{ label }}" aria-valuemin="0" aria-valuenow="{{#if health}}{{ normalValue }}{{else}}{{ value }}{{/if}}" aria-valuemax="{{ max }}"><span style="width:{{ pct }}%"></span><svg class="iw-resource-cap iw-resource-cap-start" viewBox="0 0 8 14" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width=".9" aria-hidden="true" focusable="false"><path d="M8 .5H3.5L.5 3.5v7l3 3H8M5 4H3.5v6H5" vector-effect="non-scaling-stroke"/></svg><svg class="iw-resource-cap iw-resource-cap-end" viewBox="0 0 8 14" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width=".9" aria-hidden="true" focusable="false"><path d="M8 .5H3.5L.5 3.5v7l3 3H8M5 4H3.5v6H5" vector-effect="non-scaling-stroke"/></svg></div>{{/unless}}
  {{#if pipsMode}}<div class="jj2-action-pips" role="group" aria-label="Ajustar Pontos de Ação">{{#each pips}}<button type="button" class="{{#if filled}}filled{{/if}} {{#if @root.owner}}always-interactive{{/if}}" data-action="jj2ActionPip" data-value="{{ value }}" aria-label="Definir Pontos de Ação: {{ value }}" data-tooltip="Definir Pontos de Ação: {{ value }}" aria-pressed="{{#if filled}}true{{else}}false{{/if}}" {{ disabled (not @root.owner) }}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="energy" }}</button>{{/each}}</div>{{/if}}
</div>
