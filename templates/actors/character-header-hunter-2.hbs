<header class="sheet-header jj2-header jj2-hero {{#if jj2.isRestringido}}jj2-hero-stamina{{/if}}">
  <img class="iw-wuxia-landscape" src="systems/Immortals-system/assets/wuxia/sheet-header.webp" alt="" aria-hidden="true">
  <div class="jj2-hero-art">
    <div class="jj2-portrait portrait {{#if portrait.token}}token{{/if}}">
      {{#with portrait}}
        {{#if isVideo}}<video src="{{ src }}" controls muted playsinline disablepictureinpicture {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}} {{#if (and @root.editable path)}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}></video>
        {{else}}<img src="{{ src }}" alt="{{ @root.actor.name }}" {{#if @root.editable}}data-action="{{ action }}"{{else}}data-action="showArtwork"{{/if}} {{#if (and @root.editable path)}}data-edit="{{ path }}" data-type="{{ type }}"{{/if}}>{{/if}}
      {{/with}}
    </div>
    {{#if editable}}<label class="jj2-portrait-toggle" data-tooltip="{{#if portrait.token}}Mostrar retrato{{else}}Mostrar token{{/if}}"><input type="checkbox" data-flag-path="Immortals-system.showTokenPortrait" role="switch" aria-label="Usar imagem do token" {{ checked portrait.token }}><span class="jj2-portrait-switch" aria-hidden="true"></span></label>{{/if}}
  </div>
  <div class="jj2-hero-identity">
    <div class="jj2-nameplate">
      {{#if editable}}<input type="text" name="name" class="document-name" value="{{ actor._source.name }}" aria-label="Nome do personagem">{{else}}<h1 class="document-name">{{ actor.name }}</h1>{{/if}}
    </div>
    <div class="jj2-header-meta"><span>Classe · {{#if jj2.estiloNome}}{{ jj2.estiloNome }}{{else}}Cultivador{{/if}}</span></div>
    {{#if jj2.isRestringido}}
    <div class="jj2-hero-resources jj2-stamina-resources">
      <div class="jj2-stamina-bars">
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="hp" label="Vida" path="jj2HitPointsTotal" value=jj2.hp.total max=jj2.hp.max pct=jj2.hpPct health=true normalValue=jj2.hp.value tempValue=jj2.hp.temp tempPct=jj2.hp.tempPct tempMax=jj2.hp.tempMax unbounded=true configKey="hitPoints" }}
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="wounds" label="Ferimentos" path="system.legacy2.wounds.value" value=jj2.wounds.value max=jj2.wounds.max pct=jj2.wounds.pct }}
      </div>
      <div class="jj2-header-emblems">
        <div class="jj2-stamina-emblem">
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="stamina" label="Estamina" path="system.energy.generated" value=jj2.energyAvailable max=jj2.refinement sigil=true sigilLabel="Restaurar Estamina" sigilImage="systems/Immortals-system/assets/ficha/estamina-especialista-outline.webp" }}
        </div>
        {{> "systems/Immortals-system/templates/actors/parts/jj2-action-ring.hbs" }}
        {{> "systems/Immortals-system/templates/actors/parts/jj2-shield.hbs" }}
      </div>
    </div>
    {{else}}
    <div class="jj2-hero-resources">
      <div class="jj2-header-bars">
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="hp" label="Vida" path="jj2HitPointsTotal" value=jj2.hp.total max=jj2.hp.max pct=jj2.hpPct health=true normalValue=jj2.hp.value tempValue=jj2.hp.temp tempPct=jj2.hp.tempPct tempMax=jj2.hp.tempMax unbounded=true configKey="hitPoints" }}
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="energy" label="Qi" path="system.energy.total" value=system.energy.total max=system.energy.max pct=jj2.energyPct configKey="cursedEnergy" }}
        {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="wounds" label="Ferimentos" path="system.legacy2.wounds.value" value=jj2.wounds.value max=jj2.wounds.max pct=jj2.wounds.pct }}
      </div>
      <div class="jj2-header-emblems">
      {{> "systems/Immortals-system/templates/actors/parts/jj2-resource.hbs" id="refinement" label="Qi refinado" path="system.energy.generated" value=jj2.energyAvailable max=jj2.refinement unbounded=true sigil=true sigilLabel="Refinar Qi" sigilLotus=true }}
      {{> "systems/Immortals-system/templates/actors/parts/jj2-action-ring.hbs" }}
      {{> "systems/Immortals-system/templates/actors/parts/jj2-shield.hbs" }}
      </div>
    </div>
    {{/if}}
  </div>
  <div class="jj2-hero-actions">
    {{#if wuxia.realm}}<div class="iw-wuxia-realm"><span>Reino de Cultivo</span><strong>{{wuxia.realm.name}}</strong><small>Estágio {{wuxia.realm.stage}} de 3</small><span class="iw-illumination">{{wuxia.realm.illumination}} PI</span></div>{{/if}}
    {{#if (or showRests jj2.creationPending)}}<div class="jj2-rests">{{#if jj2.creationPending}}<button type="button" data-action="jj2Creation" class="jj2-action always-interactive" aria-label="Continuar criação do personagem" data-tooltip="Continuar criação do personagem">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="personalization"}}</button>{{/if}}{{#if showRests}}{{#each CONFIG.restTypes}}<button type="button" data-action="rest" data-type="{{ @key }}" class="jj2-action always-interactive" aria-label="{{ localize label }}" data-tooltip="{{ localize label }}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key=@key }}</button>{{/each}}{{/if}}</div>{{/if}}
  </div>
</header>
