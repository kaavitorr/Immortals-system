<section class="jj2-attributes jj2-npc-attributes" aria-label="Atributos do NPC">
  {{#each jj2.abilities}}<div class="jj2-ability {{#if principal}}principal{{/if}}" data-ability="{{key}}"><button type="button" class="jj2-ability-heading {{@root.rollableClass}}" data-action="roll" data-type="ability" aria-label="Rolar {{label}}"></button>{{#if (and @root.editable (not @root.jj2.npc.derivedAttributes))}}<input type="number" name="system.abilities.{{key}}.value" value="{{sourceValue}}" min="1" max="{{maximum}}" data-dtype="Number" aria-label="{{label}}">{{else}}<strong>{{value}}</strong>{{/if}}<span class="jj2-ability-label">{{label}}</span></div>{{/each}}
</section>
