<fieldset>
    <legend>{{ localize "DND5E.ItemConsumableDetails" }}</legend>

    {{!-- Identifier --}}
    {{ formField fields.identifier value=source.identifier placeholder=item.identifier hint="DND5E.IdentifierError"
                 localize=true rootId=partId }}

    {{!-- Consumable Type --}}
    {{ formField fields.type.fields.value value=source.type.value choices=consumableTypes labelAttr="label"
                 label="DND5E.ItemConsumableType" localize=true rootId=partId }}

    {{!-- Consumable Sub-Type --}}
    {{#if itemSubtypes}}
    {{ formField fields.type.fields.subtype value=source.type.subtype choices=itemSubtypes blank="" localize=true
                 label=(ifThen beastCoreConsumable "Elemento do núcleo" (ifThen crystalConsumable "Classificação do Cristal" (localize "DND5E.ItemConsumableSubtype" category=(lookup (lookup CONFIG.consumableTypes source.type.value) "label")))) rootId=partId }}
    {{/if}}

    {{!-- Consumable Properties --}}
    {{ formField fields.properties options=properties.options localize=true input=inputs.createMultiCheckboxInput
                 stacked=true classes="checkbox-grid checkbox-grid-3"
                 label=(ifThen (eq source.type.value "ammo") "DND5E.ItemAmmoProperties" "DND5E.ItemConsumableProperties") }}

    {{!-- Magical Properties --}}
    {{#if properties.object.mgc}}
    <div class="form-group split-group">
        <label>{{ localize "DND5E.ITEM.Property.Magical" }}</label>
        <div class="form-fields">

            {{!-- Attunement --}}
            <div class="form-group label-top">
                <label>{{ localize "DND5E.Attunement" }}</label>
                <div class="form-fields">

                    {{!-- Attuned --}}
                    {{#if source.attunement}}
                    {{ formInput fields.attuned value=source.attuned input=inputs.createCheckboxInput
                                 ariaLabel=(localize "DND5E.Attuned") dataset=(dnd5e-object tooltip="DND5E.Attuned") }}
                    {{/if}}

                    {{!-- Attunement --}}
                    {{ formInput fields.attunement value=source.attunement choices=CONFIG.attunementTypes
                                 blank="DND5E.AttunementNone" localize=true }}
                </div>
            </div>

            {{!-- Magical Bonus --}}
            {{#if (and properties.object.mgc (eq source.type.value "ammo"))}}
            {{ formField fields.magicalBonus value=source.magicalBonus step=1 placeholder="0" label="DND5E.Bonus"
                         localize=true classes="label-top" rootId=partId }}
            {{/if}}
        </div>
    </div>
    {{/if}}
</fieldset>

{{#if (eq source.type.value "ammo")}}
<fieldset>
    <legend>{{ localize "DND5E.CONSUMABLE.FIELDS.damage.label" }}</legend>

    {{!-- Replace Damage --}}
    {{ formField fields.damage.fields.replace value=source.damage.replace input=inputs.createCheckboxInput
                 rootId=partId }}

    {{> "dnd5e.field-damage" fields=fields.damage.fields.base.fields source=source.damage.base
        types=damageTypes prefix="system.damage.base." }}

</fieldset>
{{/if}}

{{#if crystalConsumable}}
<fieldset class="iw-crystal-native-settings">
  <legend>Reserva de Essência</legend>
  {{#if crystalConsumable.valid}}
  <div class="iw-crystal-native-stats"><div><span>Capacidade total</span><strong>{{crystalConsumable.capacity}} <small>PEQ</small></strong></div><div><span>Essência restante</span><strong>{{crystalConsumable.remaining}} <small>PEQ</small></strong></div></div>
  <label class="iw-crystal-native-spent" for="{{partId}}-crystal-spent">Essência já absorvida <span class="form-fields"><input id="{{partId}}-crystal-spent" type="number" name="system.uses.spent" value="{{crystalConsumable.spent}}" min="0" max="{{crystalConsumable.capacity}}" step="1" data-dtype="Number"><span>PEQ</span></span></label>
  <label class="iw-crystal-toggle"><input type="checkbox" name="system.equipped" {{checked source.equipped}}> Equipado para cultivo</label>
  <p class="hint">Segure o cristal equipado ao recitar seu mantra. O calendário desconta apenas a Essência extra concedida, até esgotar esta reserva. A capacidade é definida pela classificação e precisa atingir metade da absorção efetiva: o menor limite entre o mantra e a região. A reserva não se recupera em descansos.</p>
  <p class="hint">Use um item separado para cada cristal com saldo diferente. A quantidade do item não multiplica esta reserva.</p>
  {{else}}<p class="hint">Escolha a classificação do cristal para definir sua capacidade de Essência.</p>{{/if}}
</fieldset>
{{/if}}

{{#if beastCoreConsumable}}
<fieldset class="iw-beast-core-settings">
 <legend>Núcleo de Besta</legend>
 <div class="iw-beast-core-preview">
 {{#if beastCoreConsumable.valid}}<img src="{{beastCoreConsumable.definition.img}}" alt="Núcleo de {{beastCoreConsumable.definition.label}}" width="72" height="72">{{/if}}
 <div><label for="{{partId}}-core-rank">Reino do núcleo</label><select id="{{partId}}-core-rank" name="system.beastCore.rank" data-dtype="Number">{{#each beastCoreConsumable.realms}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
 </div>
 <p class="hint">Esfera de cristal físico, usada como material em treinamentos e receitas. O Neutro não pertence a elemento algum. Cada uso de Consumir núcleo remove uma unidade, somente quando a regra exigir.</p>
 <p class="hint">Núcleos com elemento ou reino diferentes devem ficar em itens separados. Eles não concedem as transformações de uma Essência de Besta.</p>
</fieldset>
{{/if}}
