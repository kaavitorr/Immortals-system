<fieldset>
    <legend>{{ localize "DND5E.ItemLootDetails" }}</legend>

    {{!-- Identifier --}}
    {{ formField fields.identifier value=source.identifier placeholder=item.identifier hint="DND5E.IdentifierError"
                 localize=true rootId=partId }}

    {{!-- Loot Type --}}
    {{ formField fields.type.fields.value label="DND5E.ItemLootType" value=source.type.value choices=CONFIG.lootTypes
                 labelAttr="label" blank="" localize=true rootId=partId }}

    {{!-- Loot Subtype --}}
    {{#if itemSubtypes}}
    {{ formField fields.type.fields.subtype value=source.type.subtype choices=itemSubtypes blank=""
                 label=(localize "DND5E.ItemLootSubtype" category=(lookup (lookup CONFIG.lootTypes source.type.value) "label")) rootId=partId }}
    {{/if}}

    {{!-- Loot Properties --}}
    {{ formField fields.properties options=properties.options label="DND5E.ItemLootProperties" localize=true
                 input=inputs.createMultiCheckboxInput stacked=true classes="checkbox-grid" }}

</fieldset>

{{#if beastEssenceGrowth}}
<fieldset>
    <legend>Essência de Besta</legend>
    <div class="form-group"><label>Rank de crescimento</label><div class="form-fields"><span>{{beastEssenceGrowth.label}}</span>{{#if beastEssenceGrowth.canEdit}}<button type="button" data-action="beastEssenceEditGrowth">Alterar Rank</button><button type="button" data-action="beastEssenceEditSelections">Escolher habilidades</button>{{/if}}</div></div>
    <div class="form-group"><label>Limite de crescimento</label><div class="form-fields"><span>{{beastEssenceGrowth.limit}}</span></div></div>
</fieldset>
{{/if}}
