<section class="tab {{tab.cssClass}} jj2-page iw-cultivation-manual iw-manual-template" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#unless manual.hidden}}
  <div class="iw-tab-heading"><h2>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="manual"}}Manual de Cultivo</h2><span class="iw-manual-count">{{manual.techniqueCount}} técnicas</span></div>
  <div class="iw-manual-classification">
    <label><span>Rank do manual</span><select name="flags.Immortals-system.cultivationManual.rank" {{#unless manual.editable}}disabled{{/unless}}>{{#each manual.rankOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label><span>Qualidade</span><select name="flags.Immortals-system.cultivationManual.quality" {{#unless manual.editable}}disabled{{/unless}}>{{#each manual.qualityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  </div>
  <p class="iw-manual-guidance">Configure as habilidades e técnicas deste modelo. Ao instalar em uma ficha, cada item será copiado com suas atividades, dano e efeitos.</p>

  {{#*inline "iwManualTechnique"}}
  <li class="iw-manual-technique {{#if @root.manual.editable}}draggable{{/if}} {{#if blocked}}is-blocked{{/if}}" data-item-id="{{id}}" draggable="{{#if @root.manual.editable}}true{{else}}false{{/if}}">
    <img src="{{img}}" alt="">
    <div class="iw-manual-technique-copy"><strong>{{name}}</strong><span>{{#if grau}}Grau {{grau}}{{else}}Auxiliar{{/if}}{{#if blocked}} · Requisito pendente{{/if}}</span></div>
    <div class="iw-manual-item-actions">
      
      <button type="button" data-action="feiticoEdit" data-item-id="{{id}}" data-tooltip="Editar técnica" aria-label="Editar técnica" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="edit"}}</button>
      <button type="button" data-action="feiticoRemove" data-item-id="{{id}}" data-tooltip="Remover técnica do modelo" aria-label="Remover técnica do modelo" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="close"}}</button>
    </div>
  </li>
  {{/inline}}

  <div class="iw-manual-groups">
    {{#each manual.slots as |slot|}}
    <article class="iw-manual-group {{#if blocked}}is-blocked{{/if}}" data-feitico-slot="{{id}}">
      <header class="iw-manual-group-heading"><div><h3>{{label}}</h3><p>{{description}}</p></div>{{#if blocked}}<span class="iw-manual-lock" data-tooltip="{{blockedReason}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="lock"}}Requisito pendente</span>{{/if}}</header>
      {{#if manifestacao}}
      <div class="iw-manual-principle {{#if @root.manual.editable}}draggable{{/if}}" data-item-id="{{manifestacao.id}}" draggable="{{#if @root.manual.editable}}true{{else}}false{{/if}}">
        <div class="iw-manual-principle-art"><img src="{{manifestacao.img}}" alt=""></div>
        <div class="iw-manual-technique-copy"><strong>{{manifestacao.name}}</strong><span>Habilidade principal</span></div>
        <div class="iw-manual-item-actions">
          
          <button type="button" data-action="feiticoEdit" data-item-id="{{manifestacao.id}}" data-tooltip="Editar habilidade" aria-label="Editar habilidade" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="edit"}}</button>
          <button type="button" data-action="feiticoRemove" data-item-id="{{manifestacao.id}}" data-tooltip="Remover habilidade do modelo" aria-label="Remover habilidade do modelo" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="close"}}</button>
        </div>
      </div>
      <div class="iw-manual-requirements">
        {{#each requirements}}<label class="iw-manual-requirement {{#if met}}met{{else}}unmet{{/if}}"><span>Nível mínimo</span><input type="number" min="1" max="30" value="{{level}}" data-feitico-req="level" data-item-id="{{manifestacaoId}}" data-index="{{index}}" aria-label="Nível de cultivo exigido" {{#unless @root.manual.editable}}disabled{{/unless}}><button type="button" data-action="feiticoReqRemove" data-item-id="{{manifestacaoId}}" data-index="{{index}}" aria-label="Remover requisito" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="close"}}</button></label>{{/each}}
        {{#if canAddReq}}{{#if @root.manual.editable}}<button type="button" data-action="feiticoReqAdd" data-item-id="{{manifestacao.id}}">{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}Requisito</button>{{/if}}{{/if}}
      </div>
      {{else}}
      <div class="iw-manual-empty feitico-drop-zone" data-feitico-drop="manif"><span>Vincule a habilidade principal deste grupo.</span><button type="button" data-action="feiticoCreateManif" data-slot="{{id}}" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}Criar habilidade</button></div>
      {{/if}}
      <div class="iw-manual-techniques feitico-drop-zone" data-feitico-drop="tecnica"><header><h4>{{tecnicasLabel}}</h4><button type="button" data-action="feiticoCreateTecnica" data-slot="{{id}}" aria-label="Criar técnica em {{label}}" {{#unless @root.manual.editable}}disabled{{/unless}}>{{> "systems/Immortals-system/templates/actors/parts/jj2-icon.hbs" key="add"}}Técnica</button></header>
        {{#if hasTecnicas}}<ul>{{#each tecnicas}}{{> iwManualTechnique}}{{/each}}</ul>{{else}}<p class="iw-manual-empty-hint">Arraste uma técnica ou crie uma nova para este grupo.</p>{{/if}}
      </div>
    </article>
    {{/each}}
  </div>
  {{/unless}}
</section>
